# Z-Script 部署环境变量模板
# 用法：cp .env.example .env，改成自己的值，再 docker compose --env-file .env up
# 注意：.env 不要入仓（gitignore），这里只是模板

# ===== 镜像版本 =====
IMAGE_VERSION=1.0.0
OCI_REGISTRY=ghcr.io/yuku123

# ===== 后端 JVM =====
JAVA_OPTS=-Xms512m -Xmx1g

# ===== 数据库（只支持 MySQL；本机试用可用 deploy 的 with-db profile）=====
# ModuleDataSourceTemplate 的键：z.base.db.script.*（写成 spring.datasource.* 不生效）
Z_BASE_DB_SCRIPT_HOST=127.0.0.1
Z_BASE_DB_SCRIPT_PORT=3306
Z_BASE_DB_SCRIPT_DATABASE=z_script
Z_BASE_DB_SCRIPT_USERNAME=root
# 留空仅限本机一次性试用卷；生产必须设置，且只通过 env / K8s Secret 注入
Z_BASE_DB_SCRIPT_PASSWORD=

# ===== K8s 部署专用 =====
# NAMESPACE=z-script
# INGRESS_DOMAIN=script.example.com
# TLS_SECRET_NAME=z-script-tls

# ===== 前端反代目标（compose split/cluster 用）=====
# BACKEND_SERVICE=z-script-backend