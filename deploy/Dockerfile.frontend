# Z-Script 前端 nginx 镜像（Mode 2 分体 / Mode 3 集群用）
# 输入：_frontend/z-script-suit/dist/（vite build 产物，build-images.sh 的 step 1 已产出）
# 输出：nginx 静态服务 + /api 反代到 backend
#
# 为什么不在容器里跑 vite build：SPA 依赖旁侧的 z-script-component（file: 依赖 +
# vite alias 指向 ../z-script-component/dist/index.js），单拷 SPA 目录必然构建失败；
# 而宿主侧 admin 的 package（frontend-maven-plugin）已经把两层时序串好并产出 dist，
# 镜像里再装一遍 node 只会更慢。改 dist 后重跑 mvn package 再打镜像即可。
#
# 构建命令（仓库根为 context）：
#   docker build -f deploy/Dockerfile.frontend \
#     -t ghcr.io/yuku123/z-script-suit:1.0.0 .

FROM nginx:1.25-alpine

# 拷 nginx 配置 + 反代模板
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template

# 拷 build 产物
# vite 的 base 是 /script/（与 admin context-path 一致），产物必须落在 html/script/ 下
COPY _frontend/z-script-suit/dist/ /usr/share/nginx/html/script/

EXPOSE 80

# 通过 envsubst 渲染 nginx 配置（BACKEND_SERVICE 在 compose 中注入）
# nginx:1.25-alpine 自带 envsubst-on-templates.sh 在 /docker-entrypoint.d/
# 这里我们用 envsubst 手动渲染到 /etc/nginx/conf.d/default.conf
CMD ["/bin/sh", "-c", "envsubst '$$BACKEND_SERVICE' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]

LABEL org.opencontainers.image.title="z-script-suit" \
      org.opencontainers.image.description="Z-Script admin 前端 nginx 镜像" \
      org.opencontainers.image.source="https://github.com/z-opc-foundation/z-script" \
      org.opencontainers.image.licenses="MIT"
