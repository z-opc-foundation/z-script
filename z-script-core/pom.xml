<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://www.w3.org/2001/XMLSchema-instance http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-script-core: 脚本 / Mock / API Key / 配额 / 调用日志 的实体 + Mapper + Service。
        业务方不直接 import（由 z-script-web / z-script-engine 传递带入）。
    -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-script</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>z-script-core</artifactId>
    <packaging>jar</packaging>

    <name>z-script :: core</name>
    <description>脚本平台与 Mock 平台的域模型（entity / mapper / service）</description>

    <dependencies>
        <!-- Log4j2 API (本模块 src/main/java 含 LogManager.getLogger 调用) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-web-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-datasource-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>
        <!-- z-util-parser-json (替换 fastjson: 提供 JsonUtil + JsonObject + JsonArray) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-parser-json</artifactId>
        </dependency>
    </dependencies>
</project>
