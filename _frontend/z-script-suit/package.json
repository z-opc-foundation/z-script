{
  "name": "@yuku123/z-script-suit",
  "version": "0.0.0",
  "private": true,
  "description": "Z-Script 控制台应用层（脚本平台 + Mock 平台），构建产物由 z-script-admin 嵌入 jar",
  "type": "module",
  "scripts": {
    "dev": "vite",
