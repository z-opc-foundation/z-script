<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 2026-09-29 起消费入口统一是 z-boot-parent：一行 parent 白拿第三方地板 1.0.19 +
         兄弟仓权威 z-boot-fleet:1.0.0 + Java 8 的 pluginManagement，本仓不再自己摊版本表
         （迁移前 20 格）。relativePath 留空：parent 在 repo1，不在磁盘上。
         对外形状不变：发 flatten oss 的自包含 pom（repo1 回读 1.0.0 五份 <parent> 计数 0、无
         com.zifang、无悬空 ${...}，oss 还会剥掉整个 <dependencyManagement> ⇒ 本仓直接条目只在
         构建期生效），所以 flatten 必须常开，见 build 段。 -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-script</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>z-script (Script Platform + Mock Server)</name>
    <description>
        Z-Script: DSL 脚本平台 (Groovy / JS / Lua / EL / SQL 沙箱执行 + 版本化 + 标签 + 配额 + 调用审计)
        与 Mock 平台 (接口 Mock / 录制回放 / 场景编排 / 故障注入 / HTTP 多步链路),
        脚本可一键暴露为 HTTP 接口与 MCP Tool。
    </description>

    <url>https://github.com/z-opc-foundation/z-script</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-script.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-script.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-script</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <!-- 实体 / Mapper / Service: 脚本 + Mock 域模型 (业务方不直接 import) -->
        <module>z-script-core</module>

        <!-- 引擎层: 脚本沙箱执行 / Mock / 录制回放 / 断言 / 故障注入 / MCP 暴露 -->
        <module>z-script-engine</module>

        <!-- Web 层: REST Controller + AutoConfiguration (自带前端控制台的业务入口) -->
        <module>z-script-web</module>

        <!-- 场景化组装层聚合 pom (z-script-scene-http 等) -->
        <module>z-script-scene</module>

        <!-- 可独立运行的单体应用 (含 Web 控制台): 留 reactor, maven.deploy.skip=true, 永不上 Central -->
        <module>z-script-admin</module>
    </modules>

    <properties>
        <!-- 项目自身版本（CI-friendly versions 根，发版改这一处即可） -->
        <revision>1.0.2</revision>

        <!-- 2026-09-29 迁移删掉的键，逐条按**坐标**对过（preflight 第 2/5 节；迁后复跑悬空 0 格）：
             java.version / maven.compiler.{source,target} / project.build.sourceEncoding /
             compile.version → 父链供 8 / 8 / UTF-8，面值没变；util.version=1.0.13 → fleet 按
             同样那 8 个 z-util 坐标供 1.0.13；z-boot.version=1.0.17 与 spring-boot-plugin 2.7.12
             → 跟着 parent 抬 1.0.19 / 2.7.18（理由见 DM 与 build）；compiler/resources/flatten
             三格父链同值 3.11.0 / 3.3.1 / 1.7.3，引用点由父链解析。 -->
        <!-- 与父链**不同值**、刻意留着的两格：junit/platform 只能按坐标写直接 <dependency> 条目
             （import 进来的 BOM 顶不过继承来的直接 DM），surefire 靠本仓 <build><plugins> 里那条
             带显式版本的直接声明顶过继承来的 pluginManagement。逐条理由见下面 DM 与 build 的注释。 -->
        <junit.version>5.11.4</junit.version>
        <junit-platform.version>1.11.4</junit-platform.version>
        <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>

        <!-- 父链的 pluginManagement 只管 compiler/surefire/failsafe/jar/resources/spring-boot
             六件；下面这些插件坐标父链一条都不供，删键当场悬空（source 那一格见 build 里的注释）。 -->
        <maven-source-plugin.version>3.3.0</maven-source-plugin.version>
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
        <central-publishing-plugin.version>0.7.0</central-publishing-plugin.version>
        <versions-maven-plugin.version>2.17.1</versions-maven-plugin.version>
        <frontend-maven-plugin.version>1.15.0</frontend-maven-plugin.version>

        <!-- admin 前端构建：无 node 环境的机器（只发库 / Central 校验）用 -Dfrontend.skip=true 跳过。
             node/npm 是下载 URL 的坐标段、不是 Maven 坐标，地板管不到。 -->
        <frontend.skip>false</frontend.skip>
        <node.version>v18.17.0</node.version>
        <npm.version>9.6.7</npm.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- JUnit 5.11.4 / platform 1.11.4：与父链**不同值**、刻意留着（地板 1.0.19 的 junit-bom
                 是 5.9.3）。必须写成按坐标的**直接**条目：import 进来的 BOM 顶不过从 parent 继承来的
                 直接 DM，只留 import 就等于静默换测试栈。surefire 3.5.4 要 platform 1.11.x，混旧
                 platform 在 forked JVM 抛 NoSuchMethodError: CollectionUtils.forEachInReverseOrder。
                 只钉 tree 里真实出现的这 5 个坐标（jupiter-params / junit-jupiter 聚合件实测不在）。 -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-commons</artifactId>
                <version>${junit-platform.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-engine</artifactId>
                <version>${junit-platform.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-launcher</artifactId>
                <version>${junit-platform.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- 迁移删掉的 DM 条目（preflight 第 2/4/5 节逐条对过）：
                 ① z-boot-dependencies:1.0.17 的 import —— z-boot-parent 继承的就是这一坐标（1.0.19），
                    留旧号的 import 顶不过父链的直接条目、只造成 dm 打架 ⇒ 第三方权威整体交给父链。
                 ② z-boot-web-starter / z-boot-datasource-starter 1.0.17 —— parent 按同坐标直接供
                    1.0.19；repo1 回读两版全文 pom 只差自身版本号与 spring-boot 三行，依赖集合一支
                    不多不少 ⇒ 跟着抬。③ 8 支 z-util-* —— fleet 同供 1.0.13，同值 ⇒ 整条删。 -->
            <!-- 自家 7 个 reactor 坐标一律钉 ${revision}（z-boot README「消费模型」步骤 4）。不是
                 装饰：继承来的 DM 会改写**传递依赖**的版本，而现读 z-boot-fleet:1.0.0 里 z-script
                 那一格（z-script.version=1.0.0）钉的是 repo1 上的**已发布件**，且 z-script-admin
                 也在 fleet 里 ⇒ 抬 revision 时不补这一批，admin 的 fat jar 就会把旧号的 z-script-web
                 / -scene-http 字节码打进新号包里。当前 revision 与 fleet 面值同为 1.0.0，所以这一批
                 补完 tree 一行没动；实际补上的是原先漏掉的 z-script 与 z-script-admin 两条。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-script</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-script-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-script-engine</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-script-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-script-scene</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-script-scene-http</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-script-admin</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- surefire 跑 JUnit 5 需要 engine，缺一则测试静默不执行 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 把 launcher 放上 test classpath，surefire 才会用对齐后的 1.11.4 而非自带的 1.12.1 -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 这里的 pluginManagement 整段删掉了（迁移前两条：spring-boot-maven-plugin
             ${spring-boot-plugin.version}=2.7.12、maven-resources-plugin 3.3.1）：
             parent 的 pluginManagement 按同一坐标直接供 2.7.18 / 3.3.1，resources 那一格面值
             没变、spring-boot 那一格按上面 properties 段的理由跟着抬。z-script-admin 的
             copy-frontend-dist 执行与 repackage 现在都从父链取版本。 -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- 键已删，引用点留着：3.11.0 现在由父链解析（z-boot-parent/pom.xml:61，同值）。
                     source/target 从原来自家的 compile.version=8 换成父链的 maven.compiler.source
                     =8 ⇒ 面值不变；class-file major 52 已复验。
                     ⚠ parent 那份 <configuration> 的 <compilerArgs>-parameters</compilerArgs> 是
                     合并进来的、挡不住：产物 class 多一个 MethodParameters 属性，运行期参数名更好用，
                     不在这一刀里回退。 -->
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>${maven-deploy-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- 与父链**不同值**的一格（parent 的 pluginManagement 供 2.22.2），本仓刻意留着：
                     上面那 5 条 junit 5.11.4 / platform 1.11.4 直接条目要 surefire 3.5.4 才跑得动，
                     跟着父链降到 2.22.2 就是同时换测试执行器与用例计数口径。写在这里（本仓
                     <build><plugins> 的直接声明 + 显式版本）顶得过继承来的 pluginManagement。 -->
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions-maven-plugin.version}</version>
                <configuration>
                    <generateBackupPoms>false</generateBackupPoms>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <!-- 这条声明必须**常开**（不挂 central profile）：z-boot-parent 那条 flatten 是
                     <inherited>false</inherited>（z-boot-parent/pom.xml:261），不下发给消费仓，
                     而本仓对外形状是自包含 raw pom（repo1 回读 1.0.0 五份 <parent> 计数 0）⇒
                     加了 <parent> 之后不自己 flatten，发出去的就是带着 z-boot-parent:1.0.19 的废 pom。
                     版本键 1.7.3 已删，引用点由父链解析（同值）。 -->
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <!-- oss 模式: 保留 Central 要求的元数据 (url/licenses/developers/scm)
                         + 解析 CI-friendly 属性 (${revision}); 整个 <dependencyManagement> 会被
                         剥掉，所以本仓那些直接条目只在构建期生效。 -->
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>${maven-deploy-plugin.version}</version>
                        <configuration><skip>true</skip></configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <!-- 父链的 pluginManagement 只管 compiler/surefire/failsafe/jar/resources/
                             spring-boot 六件，**不含** maven-source-plugin（地板那格 3.2.1 住在
                             properties/DM 里，管不到插件版本）⇒ 这一格必须自己写，否则落到
                             Maven 默认绑定的 source 插件版本上、随 Maven 版本漂。 -->
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- 本插件不认 maven.deploy.skip：实测 z-script-admin 1.0.0 已因此漏上 Central -->
                            <excludeArtifacts>
                                <excludeArtifact>z-script-admin</excludeArtifact>
                            </excludeArtifacts>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
